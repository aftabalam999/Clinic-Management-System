# ────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES — copy to .env
# ────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/clinic-management?retryWrites=true&w=majority

# JWT — use a long, random secret (e.g. openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Frontend URL (the Vercel deployment URL — no trailing slash)
FRONTEND_URL=https://clinic-management-frontend.vercel.app
